generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  passwordHash String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  preventiveLogs PreventiveLog[]
}

model Computer {
  id                 Int             @id @default(autoincrement())
  name               String
  manufacturer       String?
  location           String?
  serialNumber       String          @unique
  os                 String
  lastPreventiveDate DateTime?
  nextPreventiveDate DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  preventiveLogs     PreventiveLog[]
}

model PreventiveLog {
  id          Int       @id @default(autoincrement())
  computerId  Int
  computer    Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  performedAt DateTime
  notes       String?
  createdAt   DateTime  @default(now())
}
